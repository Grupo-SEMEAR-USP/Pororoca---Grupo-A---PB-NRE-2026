<?xml version="1.0"?>

<robot name="wallington" xmlns:xacro="http://ros.org/wiki/xacro">

    <xacro:include filename="$(find wallington_description)/urdf/wallington_gazebo.xacro"/>
    <xacro:include filename="$(find wallington_description)/urdf/wallington_ros2_control.xacro"/>

    <link name="base_footprint" />

    <link name="chassis_link">
        <!-- O robô está com o tamanho certo de chassi, mas falta acertar a massa, meshes e matriz de inércia bonitinho-->
        <inertial>
            <origin xyz="0 0 0.075" rpy="0 0 0"/>
            <mass value = "0.15" />
            <inertia ixx="0.0015625" ixy="0" ixz="0"
                     iyy="0.0015625" iyz="0"
                     izz="0.002" />
        </inertial>
        <visual name="chassis_visual">
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="0.2 0.2 0.15" />
            </geometry>
            <material name="yellow"><color rgba="1.0 1.0 0.0 1.0"/></material>
        </visual>
        <collision name="chassis_collision">
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="0.2 0.2 0.15" />
            </geometry>
        </collision>
    </link>

    <joint name="chassis_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="chassis_link"/>
        <origin xyz= "0 0 0.1" rpy="0 0 0"/>
    </joint>

    <link name="front_left_wheel_link">
        <inertial>
            <origin xyz="0 0 0.025" rpy="0 0 0"/>
            <mass value="0.1"/>
            <inertia ixx="1.645833e-5" ixy="0.0" ixz="0.0"
                     iyy="3.125e-5" iyz="0.0"
                     izz="1.645833e-5"/>
        </inertial>

        <visual name='front_left_wheel_visual'>
            <origin xyz="0 0 0" rpy="1.57 0 0" />
            <geometry>
                <cylinder radius="0.025" length="0.01"/>
            </geometry>
            <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
        </visual>

        <collision name='front_left_wheel_collision'>
            <origin xyz="0 0 0" rpy="1.57 0 0"/>
            <geometry>
                <cylinder radius="0.025" length="0.01"/>
            </geometry>
        </collision>
    </link>

    <joint name="front_left_wheel_joint" type="continuous">
        <origin xyz="0.05 0.105 -0.075" rpy="0.0 0.0 0.0"/>
        <parent link="chassis_link"/>
        <child link ="front_left_wheel_link"/>
        <axis xyz="0 1 0"/>
    </joint>

    <link name="front_right_wheel_link">
        <inertial>
            <origin xyz="0 0 0.025" rpy="0 0 0"/>
            <mass value="0.1"/>
            <inertia ixx="1.645833e-5" ixy="0.0" ixz="0.0"
                     iyy="3.125e-5" iyz="0.0"
                     izz="1.645833e-5"/>
        </inertial>

        <visual name='front_right_wheel_visual'>
            <origin xyz="0 0 0" rpy="1.57 0 0" />
            <geometry>
                <cylinder radius="0.025" length="0.01"/>
            </geometry>
            <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
        </visual>

        <collision name='front_right_wheel_collision'>
            <origin xyz="0 0 0" rpy="1.57 0 0"/>
            <geometry>
                <cylinder radius="0.025" length="0.01"/>
            </geometry>
        </collision>
    </link>

    <joint name="front_right_wheel_joint" type="continuous">
        <origin xyz="0.05 -0.105 -0.075" rpy="0.0 0.0 0.0"/>
        <parent link="chassis_link"/>
        <child link ="front_right_wheel_link"/>
        <axis xyz="0 1 0"/>
    </joint>

    <link name="back_left_wheel_link">
        <inertial>
            <origin xyz="0 0 0.025" rpy="0 0 0"/>
            <mass value="0.1"/>
            <inertia ixx="1.645833e-5" ixy="0.0" ixz="0.0"
                     iyy="3.125e-5" iyz="0.0"
                     izz="1.645833e-5"/>
        </inertial>

        <visual name='back_left_wheel_visual'>
            <origin xyz="0 0 0" rpy="1.57 0 0" />
            <geometry>
                <cylinder radius="0.025" length="0.01"/>
            </geometry>
            <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
        </visual>

        <collision name='back_left_wheel_collision'>
            <origin xyz="0 0 0" rpy="1.57 0 0"/>
            <geometry>
                <cylinder radius="0.025" length="0.01"/>
            </geometry>
        </collision>
    </link>

    <joint name="back_left_wheel_joint" type="continuous">
        <origin xyz="-0.05 0.105 -0.075" rpy="0.0 0.0 0.0"/>
        <parent link="chassis_link"/>
        <child link ="back_left_wheel_link"/>
        <axis xyz="0 1 0"/>
    </joint>

    <link name="back_right_wheel_link">
        <inertial>
            <origin xyz="0 0 0.025" rpy="0 0 0"/>
            <mass value="0.1"/>
            <inertia ixx="1.645833e-5" ixy="0.0" ixz="0.0"
                     iyy="3.125e-5" iyz="0.0"
                     izz="1.645833e-5"/>
        </inertial>

        <visual name='back_right_wheel_visual'>
            <origin xyz="0 0 0" rpy="1.57 0 0" />
            <geometry>
                <cylinder radius="0.025" length="0.01"/>
            </geometry>
            <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
        </visual>

        <collision name='back_right_wheel_collision'>
            <origin xyz="0 0 0" rpy="1.57 0 0"/>
            <geometry>
                <cylinder radius="0.025" length="0.01"/>
            </geometry>
        </collision>
    </link>

    <joint name="back_right_wheel_joint" type="continuous">
        <origin xyz="-0.05 -0.105 -0.075" rpy="0.0 0.0 0.0"/>
        <parent link="chassis_link"/>
        <child link ="back_right_wheel_link"/>
        <axis xyz="0 1 0"/>
    </joint>

    <link name="camera_link">
        <inertial>
            <origin xyz="0 0 0.1" rpy="0 0 0"/>
            <mass value="0.05"/>
            <inertia ixx="2e-6" ixy="0.0" ixz="0.0"
                     iyy="2e-6" iyz="0.0"
                     izz="2e-6"/>
        </inertial>

        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.01"/>
            </geometry>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.01"/>
            </geometry>
        </collision>
    </link>

    <joint name="camera_joint" type="fixed">
        <origin xyz="0.1 0 0" rpy="0 0 0"/>
        <parent link="chassis_link"/>
        <child link="camera_link"/>
        <axis xyz="0 0 0"/>
    </joint>

</robot>